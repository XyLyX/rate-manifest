# Copy this file to .env and fill in real values as they become available.
# Nothing in this file is a working credential.

# --- Database ---
# Local dev default (SQLite - zero setup, see DECISIONS.md for why):
DATABASE_URL="file:./dev.db"
# Production (Postgres - swap this in when deploying, no schema changes needed):
# DATABASE_URL="postgresql://user:password@host:5432/rate_manifest?schema=public"

# --- Travelpayouts / Hotellook ---
# Dead end - Hotellook (this whole API) shut down permanently in October
# 2025. Left here only because travelpayoutsAdapter.ts still checks for
# it and no-ops safely without it. See DECISIONS.md.
TRAVELPAYOUTS_TOKEN=""
TRAVELPAYOUTS_MARKER=""

# --- StayingAPI ---
# Real cross-OTA price comparison - the actual live data source. Sign up
# free at https://stayingapi.com (300 free credits, no card). A
# stay_test_ key only returns sandbox fixture data (see
# stayingApiAdapter.ts) - verify your email and use a stay_live_ key for
# real results. See DECISIONS.md, "Real hotel data: evaluating options
# beyond Travelpayouts."
STAYINGAPI_KEY=""

# --- StayingAPI refresh job ---
# Protects /api/admin/refresh-staying-api the same way DB_INIT_SECRET
# protects /api/admin/init-db - a long random string, set directly in
# Netlify's env vars (never committed) and as a GitHub Actions secret of
# the same name for the "Refresh StayingAPI prices" workflow. See
# DECISIONS.md, "Live StayingAPI calls and the refresh architecture."
REFRESH_STAYINGAPI_SECRET=""

# --- Viator (Things To Do) ---
# Real Viator product data, rendered as RateManifest's own cards - the
# Things To Do vertical alongside the hotel comparison. Sign up free at
# https://partners.viator.com/signup - creating the account immediately
# gives Basic Access to the sandbox API, no approval needed. See
# DECISIONS.md, "Decision: build a native Viator Things To Do
# integration." Sandbox keys can take up to 24 hours to activate.
VIATOR_SANDBOX_API_KEY=""
# Only set once you've gone through Viator's production-key process
# (requires filling in contact details on their dashboard first) - see
# src/lib/viator/client.ts, which prefers this over the sandbox key
# whenever both are set.
VIATOR_PRODUCTION_API_KEY=""

# --- App ---
# Used to build absolute click-through / redirect URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- WhatsApp check-in (MVP version - no Business API needed) ---
# Your own WhatsApp number, E.164 digits only (no +, spaces, or dashes),
# e.g. "9715XXXXXXXX" for a UAE mobile. When set, the stub-booking page
# shows a "Confirm this stay on WhatsApp" link that opens a chat TO this
# number with the hotel/supplier/dates pre-filled - see DECISIONS.md.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
